# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# local runtime data and generated deployment artifacts
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
db_dump.json
dev.log
deploy.tar.gz

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local deploy config (contains secrets)
.deploy_config

# 导出图片（本地生成，不入库）
exports/
